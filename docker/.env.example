# ============================================================================
# REDACTED_HOSTNAME_UC CLOUD PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copia questo file in .env e configura i tuoi valori:
# cp .env.example .env
# ============================================================================

# ============================================================================
# CERTIFICATI SSL E DOMINIO
# ============================================================================
EMAIL=tua-email@example.com

# ============================================================================
# CONFIGURAZIONE IMMICH (GESTIONE FOTO)
# ============================================================================
IMMICH_VERSION=release
IMMICH_TZ=Europe/Rome
# IP LAN su cui esporre la porta Immich (2283) per accesso diretto in rete
# locale, bypassando nginx/WAN. NON esposto su WAN (router forwarda solo 80/443).
IMMICH_LAN_IP=REDACTED_LAN_IP
IMMICH_DATA=./data/immich/library
IMMICH_DB_DATA=./data/immich/postgres
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=CAMBIA_QUESTA_PASSWORD_IMMICH
IMMICH_API_KEY=GENERA_UNA_API_KEY

# ============================================================================
# CONFIGURAZIONE ICLOUD SYNC (OPZIONALE)
# ============================================================================
ICLOUD_USERNAME=tuo@email.icloud.com
ICLOUD_TZ=Europe/Rome
ICLOUD_UID=1000
ICLOUD_GID=1000
ICLOUD_PHOTOS_DIR=./data/icloud-photos
ICLOUD_SYNC_INTERVAL=3600
SMTP_USERNAME=
SMTP_PASSWORD=
ICLOUD_FOLDER_STRUCTURE={:%Y/%m}

# ============================================================================
# CONFIGURAZIONE JELLYFIN (MEDIA SERVER)
# ============================================================================
JELLYFIN_TZ=Europe/Rome
JELLYFIN_UID=1000
JELLYFIN_GID=1000
JELLYFIN_PORT=8096
JELLYFIN_CONFIG=./data/jellyfin/config
JELLYFIN_CACHE=./data/jellyfin/cache
JELLYFIN_MEDIA=/path/to/your/media
JELLYFIN_MEDIA2=/path/to/your/media2
JELLYFIN_MEDIA_READONLY=true
JELLYFIN_FONTS=/usr/share/fonts

# ============================================================================
# CONFIGURAZIONE PLEX (MEDIA SERVER ALTERNATIVO)
# ============================================================================
PLEX_TZ=Europe/Rome
PLEX_UID=1000
PLEX_GID=1000
PLEX_CLAIM_TOKEN=
PLEX_CONFIG=./data/plex/config

# ============================================================================
# CONFIGURAZIONE JELLYPLEX-WATCHED (SYNC STATO VISUALIZZAZIONE)
# ============================================================================
JELLYPLEX_PUID=1000
JELLYPLEX_PGID=1000
JELLYPLEX_TZ=Europe/Rome
JELLYFIN_BASEURL=http://jellyfin:8096
JELLYFIN_TOKEN=il-tuo-token-jellyfin-api
PLEX_BASEURL=http://plex:32400
PLEX_TOKEN=il-tuo-token-plex-api
DRYRUN=false
RUN_ONLY_ONCE=false
SLEEP_DURATION=3600
SYNC_FROM_PLEX_TO_JELLYFIN=true
SYNC_FROM_JELLYFIN_TO_PLEX=true
MARK_PLAYED_AT_PERCENT=90

# ============================================================================
# CONFIGURAZIONE BITWARDEN (VAULTWARDEN)
# ============================================================================
BITWARDEN_DOMAIN=https://bitwarden.REDACTED_HOSTNAME.REDACTED_DDNS
BITWARDEN_ADMIN_TOKEN=CAMBIA_QUESTO_TOKEN
BITWARDEN_SIGNUPS_ALLOWED=false
BITWARDEN_SIGNUPS_VERIFY=false
BITWARDEN_INVITATIONS_ALLOWED=true
BITWARDEN_WEBSOCKET_ENABLED=true
BITWARDEN_TZ=Europe/Rome
BITWARDEN_SMTP_HOST=smtp.gmail.com
BITWARDEN_SMTP_PORT=587
BITWARDEN_SMTP_SSL=true
BITWARDEN_SMTP_EXPLICIT_TLS=false
BITWARDEN_SMTP_FROM=tuo@email.com
BITWARDEN_SMTP_FROM_NAME=Vaultwarden
BITWARDEN_SMTP_USERNAME=tuo@email.com
BITWARDEN_SMTP_PASSWORD=
BITWARDEN_SMTP_AUTH_MECHANISM=
BITWARDEN_SMTP_TIMEOUT=15
BITWARDEN_SMTP_HELO_NAME=
BITWARDEN_SMTP_EMBED_IMAGES=true
BITWARDEN_SMTP_ACCEPT_INVALID_CERTS=false
BITWARDEN_SMTP_ACCEPT_INVALID_HOSTNAMES=false

# ============================================================================
# SMART CHECK (DISCHI)
# ============================================================================

SMART_DEVICES="/dev/sda /dev/sdb"
SMART_CHECK_INTERVAL=12h
SMART_ALERT_EMAIL=REDACTED_SERVICE_EMAIL
SMART_SMTP_HOST=smtp.gmail.com
SMART_SMTP_PORT=465
SMART_SMTP_USERNAME=tuo@email.com
SMART_SMTP_PASSWORD=
SMART_SMTP_FROM=tuo@email.com
SMART_SMTP_FROM_NAME=REDACTED_BRAND SMART Monitor
SMART_SMTP_SSL=true
SMART_SMTP_EXPLICIT_TLS=false

# ============================================================================
# ============================================================================
# SMTP: usa di default le variabili SMTP_* condivise (in cima al file).
# Comportamento (default allineati a config.yaml/app):

# ============================================================================
# ============================================================================

# ==========================================================================
# CONFIGURAZIONE WEBDAV (BACKUP GRAPHENEOS)
# ==========================================================================

WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_AUTH_TYPE=Basic
WEBDAV_DATA=./data/webdav

# ==========================================================================
# CONFIGURAZIONE RADICALE (CARDDAV/CALDAV) PER DAVX5
# ==========================================================================

RADICALE_USERNAME=
RADICALE_PASSWORD=
RADICALE_DATA=./data/radicale/data

# ============================================================================
# SYNCTHING - FILE SYNCHRONIZATION
# ============================================================================
SYNCTHING_DATA=./data/syncthing

# ============================================================================
# NOTE
# ============================================================================
# - Cambia tutte le password/token con valori sicuri
# - Genera BITWARDEN_ADMIN_TOKEN con: openssl rand -base64 48
# - Aggiungi il dominio bitwarden.REDACTED_HOSTNAME.REDACTED_DDNS al DNS
# - Configura WEBDAV_USERNAME e WEBDAV_PASSWORD con valori sicuri