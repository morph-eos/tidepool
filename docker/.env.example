# ============================================================================
# REDACTED_HOSTNAME_UC CLOUD PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copia questo file in .env e configura i tuoi valori:
#   cp .env.example .env
# Ogni variabile usata da docker-compose.yml compare qui (gli override SMTP per
# servizio sono raggruppati su una riga). Quelle con un default nel compose sono
# commentate: decommentale solo per cambiare il valore.
# I valori SMTP_* / NEXTCLOUD_* / BITWARDEN_* / SMART_* sono gestiti da
# nas-scripts/setup_mail.sh (relay condiviso): rieseguirlo li riallinea.
# ============================================================================

# ============================================================================
# CERTIFICATI SSL E DOMINIO
# ============================================================================
# Email per Let's Encrypt (certbot). Obbligatoria: deploy.sh e kickstart.sh
# rifiutano di partire con il valore di esempio.
EMAIL=tua-email@example.com
# TZ=Europe/Rome

# ============================================================================
# SMTP CONDIVISO (relay usato da Nextcloud, Vaultwarden, SMART, iCloud)
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="Servizi"
# SMTP_SSL=true  -> TLS implicito (465); SMTP_EXPLICIT_TLS=true -> STARTTLS (587)
SMTP_SSL=false
SMTP_EXPLICIT_TLS=true

# ============================================================================
# CONFIGURAZIONE IMMICH (GESTIONE FOTO)
# ============================================================================
IMMICH_VERSION=release
IMMICH_TZ=Europe/Rome
# IMMICH_PORT=2283
# IP LAN su cui esporre la porta Immich per accesso diretto in rete locale,
# bypassando nginx/WAN. NON esposto su WAN (il router inoltra solo 80/443).
IMMICH_LAN_IP=REDACTED_LAN_IP
IMMICH_DATA=./data/immich/library
IMMICH_DB_DATA=./data/immich/postgres
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=CAMBIA_QUESTA_PASSWORD_IMMICH
IMMICH_API_KEY=GENERA_UNA_API_KEY

# ============================================================================
# CONFIGURAZIONE ICLOUD SYNC (OPZIONALE, profilo `icloud`)
# ============================================================================
ICLOUD_USERNAME=tuo@email.icloud.com
# ICLOUD_TZ=Europe/Rome
# ICLOUD_UID=1000
# ICLOUD_GID=1000
# ICLOUD_PHOTOS_DIR=./data/icloud-photos
# ICLOUD_SYNC_INTERVAL=3600

# ============================================================================
# CONFIGURAZIONE JELLYFIN (MEDIA SERVER)
# ============================================================================
JELLYFIN_CONFIG=./data/jellyfin/config
JELLYFIN_CACHE=./data/jellyfin/cache
JELLYFIN_MEDIA=/path/to/your/media
# JELLYFIN_MEDIA2=/path/to/your/media2
# Il default e' sola lettura; mettere false per montare i media in scrittura
# JELLYFIN_MEDIA_READONLY=true
# JELLYFIN_FONTS=/usr/share/fonts
# JELLYFIN_TZ=Europe/Rome
# JELLYFIN_UID=1000
# JELLYFIN_GID=1000
# JELLYFIN_PORT=8096
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com

# ============================================================================
# CONFIGURAZIONE PLEX (profilo `plex`, spento di default)
# ============================================================================
PLEX_CONFIG=./data/plex/config
PLEX_CLAIM_TOKEN=
# PLEX_ADVERTISE_IP=https://plex.example.com:443
# PLEX_TZ=Europe/Rome
# PLEX_UID=1000
# PLEX_GID=1000

# ============================================================================
# CONFIGURAZIONE JELLYPLEX-WATCHED (profilo `plex`)
# Le variabili senza prefisso JELLYPLEX_ sono lette direttamente dal container
# tramite env_file: .env
# ============================================================================
# JELLYPLEX_PUID=1000
# JELLYPLEX_PGID=1000
# JELLYPLEX_TZ=Europe/Rome
JELLYFIN_BASEURL=http://jellyfin:8096
JELLYFIN_TOKEN=il-tuo-token-jellyfin-api
PLEX_BASEURL=http://plex:32400
PLEX_TOKEN=il-tuo-token-plex-api
DRYRUN=false
RUN_ONLY_ONCE=false
SLEEP_DURATION=3600
SYNC_FROM_PLEX_TO_JELLYFIN=true
SYNC_FROM_JELLYFIN_TO_PLEX=true
MARK_PLAYED_AT_PERCENT=90

# ============================================================================
# CONFIGURAZIONE BITWARDEN (VAULTWARDEN)
# ============================================================================
# Genera il token con: openssl rand -base64 48
BITWARDEN_ADMIN_TOKEN=CAMBIA_QUESTO_TOKEN
# BITWARDEN_DOMAIN=https://bitwarden.example.com
# BITWARDEN_SIGNUPS_ALLOWED=false
# BITWARDEN_SIGNUPS_VERIFY=false
# BITWARDEN_INVITATIONS_ALLOWED=true
# BITWARDEN_WEBSOCKET_ENABLED=true
# BITWARDEN_TZ=Europe/Rome
# SSO via OIDC (Nextcloud come IdP). Con il pannello admin, config.json ha la precedenza.
# BITWARDEN_SSO_ENABLED=false
# BITWARDEN_SSO_AUTHORITY=https://cloud.example.com
# BITWARDEN_SSO_CLIENT_ID=
# BITWARDEN_SSO_CLIENT_SECRET=
# BITWARDEN_SSO_PKCE=true
# Override SMTP solo per Vaultwarden (altrimenti eredita SMTP_*):
# BITWARDEN_SMTP_HOST= / _PORT= / _SSL= / _EXPLICIT_TLS= / _FROM= / _FROM_NAME= / _USERNAME= / _PASSWORD=

# ============================================================================
# CONFIGURAZIONE NEXTCLOUD (cloud personale e IdP OIDC)
# ============================================================================
NEXTCLOUD_DB_PASSWORD=CAMBIA_QUESTA_PASSWORD_NEXTCLOUD
# Se assente, MariaDB usa NEXTCLOUD_DB_PASSWORD anche come password di root.
# backup_offsite.sh e setup_nextcloud_oidc.sh leggono NEXTCLOUD_DB_ROOT_PASSWORD.
NEXTCLOUD_DB_ROOT_PASSWORD=CAMBIA_QUESTA_PASSWORD_ROOT_NEXTCLOUD
NEXTCLOUD_ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD_ADMIN_NEXTCLOUD
# NEXTCLOUD_ADMIN_USER=admin
# NEXTCLOUD_DB_NAME=nextcloud
# NEXTCLOUD_DB_USER=nextcloud
# NEXTCLOUD_TRUSTED_DOMAINS="cloud.example.com cloud.example.net"
# NEXTCLOUD_OVERWRITECLIURL=https://cloud.example.com
# SMTP: eredita SMTP_*; gestito da setup_mail.sh (mail_from = parte locale di SMTP_FROM)
# NEXTCLOUD_SMTP_SECURE=tls
# NEXTCLOUD_SMTP_AUTHTYPE=LOGIN
# NEXTCLOUD_MAIL_FROM_ADDRESS=
# NEXTCLOUD_MAIL_DOMAIN=

# ============================================================================
# CONFIGURAZIONE WEBDAV (BACKUP GRAPHENEOS / SEEDVAULT)
# ============================================================================
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_DATA=./data/webdav
# WEBDAV_AUTH_TYPE=Basic
# WEBDAV_SERVER_NAMES=webdav.example.com

# ============================================================================
# SYNCTHING - FILE SYNCHRONIZATION
# ============================================================================
# SYNCTHING_DATA=./data/syncthing
# SYNCTHING_PUID=1000
# SYNCTHING_PGID=1000

# ============================================================================
# SMART CHECK (DISCHI)
# ============================================================================
# I device sono symlink udev creati da setup_disk.sh
# SMART_DEVICES="/dev/smartcheck-nas2 /dev/smartcheck-nas"
SMART_ALERT_EMAIL=tuo@email.com
# SMART_CHECK_INTERVAL=12h
# Soglie di allerta (default sotto)
# SMART_TEMP_WARN=45
# SMART_TEMP_CRIT=50
# SMART_REALLOCATED_WARN=1
# SMART_PENDING_WARN=1
# SMART_CRC_WARN=1
# SMART_CMD_TIMEOUT_WARN=1
# SMART_SPIN_RETRY_WARN=1
# Override SMTP solo per smartcheck (altrimenti eredita SMTP_*):
# SMART_SMTP_HOST= / _PORT= / _SSL= / _EXPLICIT_TLS= / _FROM= / _FROM_NAME= / _USERNAME= / _PASSWORD=

# ============================================================================
# ============================================================================
# SMTP: usa di default le variabili SMTP_* condivise (in cima al file).
# Override SMTP solo per questo servizio:

# ============================================================================
# ============================================================================
COPILOT_GITHUB_TOKEN=

# ============================================================================
# NOTE
# ============================================================================
# - Cambia tutte le password/token con valori sicuri
# - .env non e' versionato (vedi .gitignore) ma e' incluso nel backup Borg
# - Aggiungi al DNS i nomi coperti dal certificato (vedi README, "DNS Richiesto")
