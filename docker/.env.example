# ============================================================================
# REDACTED_HOSTNAME_UC CLOUD PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and set your values:
#   cp .env.example .env
# Every variable used by docker-compose.yml appears here (per-service SMTP overrides
# are grouped on one line). Those with a default in the compose file are
# commented out: uncomment them only to change the value.
# The SMTP_* / NEXTCLOUD_* / BITWARDEN_* / SMART_* values are managed by
# nas-scripts/setup_mail.sh (shared relay): running it again realigns them.
# ============================================================================

# ============================================================================
# SSL CERTIFICATES AND DOMAIN
# ============================================================================
# Email for Let's Encrypt (certbot). Required: deploy.sh and kickstart.sh
# refuse to start with the example value.
EMAIL=tua-email@example.com
# Default time zone (services without a dedicated TZ)
# TZ=Europe/Rome

# ============================================================================
# SHARED SMTP (relay used by Nextcloud, Vaultwarden, SMART, iCloud)
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="Servizi"
# SMTP_SSL=true  -> implicit TLS (465); SMTP_EXPLICIT_TLS=true -> STARTTLS (587)
SMTP_SSL=false
SMTP_EXPLICIT_TLS=true

# ============================================================================
# IMMICH CONFIGURATION (PHOTO MANAGEMENT)
# ============================================================================
IMMICH_VERSION=release
IMMICH_TZ=Europe/Rome
# IMMICH_PORT=2283
# LAN IP on which to expose the Immich port for direct access on the local network,
# bypassing nginx/WAN. NOT exposed on the WAN (the router only forwards 80/443).
IMMICH_LAN_IP=REDACTED_LAN_IP
IMMICH_DATA=./data/immich/library
IMMICH_DB_DATA=./data/immich/postgres
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=CAMBIA_QUESTA_PASSWORD_IMMICH
IMMICH_API_KEY=GENERA_UNA_API_KEY

# ============================================================================
# ICLOUD SYNC CONFIGURATION (OPTIONAL, profile `icloud`)
# ============================================================================
ICLOUD_USERNAME=tuo@email.icloud.com
# ICLOUD_TZ=Europe/Rome
# ICLOUD_UID=1000
# ICLOUD_GID=1000
# ICLOUD_PHOTOS_DIR=./data/icloud-photos
# ICLOUD_SYNC_INTERVAL=3600

# ============================================================================
# JELLYFIN CONFIGURATION (MEDIA SERVER)
# ============================================================================
JELLYFIN_CONFIG=./data/jellyfin/config
JELLYFIN_CACHE=./data/jellyfin/cache
JELLYFIN_MEDIA=/path/to/your/media
# JELLYFIN_MEDIA2=/path/to/your/media2
# The default is read-only; set to false to mount the media read-write
# JELLYFIN_MEDIA_READONLY=true
# JELLYFIN_FONTS=/usr/share/fonts
# JELLYFIN_TZ=Europe/Rome
# JELLYFIN_UID=1000
# JELLYFIN_GID=1000
# JELLYFIN_PORT=8096
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com

# ============================================================================
# PLEX CONFIGURATION (profile `plex`, off by default)
# ============================================================================
PLEX_CONFIG=./data/plex/config
PLEX_CLAIM_TOKEN=
# PLEX_ADVERTISE_IP=https://plex.example.com:443
# PLEX_TZ=Europe/Rome
# PLEX_UID=1000
# PLEX_GID=1000

# ============================================================================
# JELLYPLEX-WATCHED CONFIGURATION (profile `plex`)
# Variables without the JELLYPLEX_ prefix are read directly by the container
# through env_file: .env
# ============================================================================
# JELLYPLEX_PUID=1000
# JELLYPLEX_PGID=1000
# JELLYPLEX_TZ=Europe/Rome
JELLYFIN_BASEURL=http://jellyfin:8096
JELLYFIN_TOKEN=il-tuo-token-jellyfin-api
PLEX_BASEURL=http://plex:32400
PLEX_TOKEN=il-tuo-token-plex-api
DRYRUN=false
RUN_ONLY_ONCE=false
SLEEP_DURATION=3600
SYNC_FROM_PLEX_TO_JELLYFIN=true
SYNC_FROM_JELLYFIN_TO_PLEX=true
MARK_PLAYED_AT_PERCENT=90

# ============================================================================
# BITWARDEN CONFIGURATION (VAULTWARDEN)
# ============================================================================
# Generate the token with: openssl rand -base64 48
BITWARDEN_ADMIN_TOKEN=CAMBIA_QUESTO_TOKEN
# BITWARDEN_DOMAIN=https://bitwarden.example.com
# BITWARDEN_SIGNUPS_ALLOWED=false
# BITWARDEN_SIGNUPS_VERIFY=false
# BITWARDEN_INVITATIONS_ALLOWED=true
# BITWARDEN_WEBSOCKET_ENABLED=true
# BITWARDEN_TZ=Europe/Rome
# SSO via OIDC (Nextcloud as IdP). With the admin panel, config.json takes precedence.
# BITWARDEN_SSO_ENABLED=false
# BITWARDEN_SSO_AUTHORITY=https://cloud.example.com
# BITWARDEN_SSO_CLIENT_ID=
# BITWARDEN_SSO_CLIENT_SECRET=
# BITWARDEN_SSO_PKCE=true
# SMTP override for Vaultwarden only (otherwise it inherits SMTP_*):
# BITWARDEN_SMTP_HOST= / _PORT= / _SSL= / _EXPLICIT_TLS= / _FROM= / _FROM_NAME= / _USERNAME= / _PASSWORD=

# ============================================================================
# NEXTCLOUD CONFIGURATION (personal cloud and OIDC IdP)
# ============================================================================
NEXTCLOUD_DB_PASSWORD=CAMBIA_QUESTA_PASSWORD_NEXTCLOUD
# If absent, MariaDB also uses NEXTCLOUD_DB_PASSWORD as the root password.
# backup_offsite.sh and setup_nextcloud_oidc.sh read NEXTCLOUD_DB_ROOT_PASSWORD.
NEXTCLOUD_DB_ROOT_PASSWORD=CAMBIA_QUESTA_PASSWORD_ROOT_NEXTCLOUD
NEXTCLOUD_ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD_ADMIN_NEXTCLOUD
# NEXTCLOUD_ADMIN_USER=admin
# NEXTCLOUD_DB_NAME=nextcloud
# NEXTCLOUD_DB_USER=nextcloud
# NEXTCLOUD_TRUSTED_DOMAINS="cloud.example.com cloud.example.net"
# NEXTCLOUD_OVERWRITECLIURL=https://cloud.example.com
# SMTP: inherits SMTP_*; managed by setup_mail.sh (mail_from = local part of SMTP_FROM)
# NEXTCLOUD_SMTP_SECURE=tls
# NEXTCLOUD_SMTP_AUTHTYPE=LOGIN
# NEXTCLOUD_MAIL_FROM_ADDRESS=
# NEXTCLOUD_MAIL_DOMAIN=

# ============================================================================
# WEBDAV CONFIGURATION (GRAPHENEOS / SEEDVAULT BACKUP)
# ============================================================================
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_DATA=./data/webdav
# WEBDAV_AUTH_TYPE=Basic
# WEBDAV_SERVER_NAMES=webdav.example.com

# ============================================================================
# SYNCTHING - FILE SYNCHRONIZATION
# ============================================================================
# SYNCTHING_DATA=./data/syncthing
# SYNCTHING_PUID=1000
# SYNCTHING_PGID=1000

# ============================================================================
# SMART CHECK (DISKS)
# ============================================================================
# The devices are udev symlinks created by setup_disk.sh
# SMART_DEVICES="/dev/smartcheck-nas2 /dev/smartcheck-nas"
SMART_ALERT_EMAIL=tuo@email.com
# SMART_CHECK_INTERVAL=12h
# Alert thresholds (defaults below)
# SMART_TEMP_WARN=45
# SMART_TEMP_CRIT=50
# SMART_REALLOCATED_WARN=1
# SMART_PENDING_WARN=1
# SMART_CRC_WARN=1
# SMART_CMD_TIMEOUT_WARN=1
# SMART_SPIN_RETRY_WARN=1
# SMTP override for smartcheck only (otherwise it inherits SMTP_*):
# SMART_SMTP_HOST= / _PORT= / _SSL= / _EXPLICIT_TLS= / _FROM= / _FROM_NAME= / _USERNAME= / _PASSWORD=

# ============================================================================
# NOTES
# ============================================================================
# - Change every password/token to a secure value
# - .env is not versioned (see .gitignore) but is included in the Borg backup
# - Add to DNS the names covered by the certificate (see the README, "The shared certificate")
